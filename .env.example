# Copy thành .env.local (khi chạy local) hoặc khai báo trong Vercel → Settings → Environment Variables.

# Domain chính thức — dùng cho canonical, sitemap, RSS, JSON-LD, ảnh OG.
# Bỏ trống trên Vercel thì tự lấy domain production của project.
NEXT_PUBLIC_SITE_URL=https://ten-mien-cua-ban.com

# Form liên hệ (/contact) gửi email qua Resend — https://resend.com (gói miễn phí đủ dùng).
RESEND_API_KEY=
# Email nhận tin nhắn liên hệ.
CONTACT_TO_EMAIL=
# Tuỳ chọn: địa chỉ gửi (cần domain đã xác minh trên Resend). Mặc định: onboarding@resend.dev
CONTACT_FROM_EMAIL=
